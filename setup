#!/usr/bin/env bash
# Install the SBL Stack skills for Claude Code. The MCP server is hosted; this
# script never reads or stores an SBL API key.
set -euo pipefail

SBL_INSTALL_HOME="${SBL_SETUP_HOME:-$HOME}"
SKILLS_ROOT="$SBL_INSTALL_HOME/.claude/skills"
SBL_NAMESPACE="$SKILLS_ROOT/sbl"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo ""
echo "SBL Stack 0.2.3 — skill setup"
echo ""

mkdir -p "$SBL_NAMESPACE/playbooks"
cp "$SCRIPT_DIR/playbooks/"*.md "$SBL_NAMESPACE/playbooks/"

# Install the Claude Code home skill and retain the independent controlled-launch
# checklist that the home and create flows load before any launch-affecting step.
sed \
  -e "s|sbl-create/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-create/SKILL.md|g" \
  -e "s|sbl-optimize/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-optimize/SKILL.md|g" \
  -e "s|sbl-triage/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-triage/SKILL.md|g" \
  -e "s|sbl-playbook/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-playbook/SKILL.md|g" \
  -e "s|sbl-retro/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-retro/SKILL.md|g" \
  -e "s|sbl-science/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-science/SKILL.md|g" \
  -e "s|sbl/SKILL_MCP.md|$SBL_NAMESPACE/SKILL_MCP.md|g" \
  "$SCRIPT_DIR/sbl/INSTRUCTIONS.md" > "$SBL_NAMESPACE/SKILL.md"
cp "$SCRIPT_DIR/sbl/SKILL_MCP.md" "$SBL_NAMESPACE/SKILL_MCP.md"

for skill in sbl-create sbl-optimize sbl-triage sbl-playbook sbl-retro sbl-science; do
  mkdir -p "$SKILLS_ROOT/$skill"
  sed \
    -e "s|playbooks/|$SBL_NAMESPACE/playbooks/|g" \
    -e "s|sbl-playbook/INSTRUCTIONS.md|$SKILLS_ROOT/sbl-playbook/SKILL.md|g" \
    -e "s|sbl-playbook/SKILL.md|$SKILLS_ROOT/sbl-playbook/SKILL.md|g" \
    -e "s|sbl/SKILL_MCP.md|$SBL_NAMESPACE/SKILL_MCP.md|g" \
    "$SCRIPT_DIR/$skill/INSTRUCTIONS.md" > "$SKILLS_ROOT/$skill/SKILL.md"
done

echo "Installed: sbl, sbl-create, sbl-optimize, sbl-triage, sbl-playbook, sbl-retro, sbl-science"
echo ""
echo "Hosted MCP: https://mcp.sbl.so/mcp"
echo "API keys:   https://app.secondbrainlabs.com/mcp-server"
echo "OAuth (no API key): claude mcp add --transport http sbl https://mcp.sbl.so/mcp, then /mcp -> sbl -> Authenticate"echo ""
echo "This script deliberately did not request, print, or persist your API key."
echo "Set SBL_API_KEY in the environment or secret manager used to start Claude Code."
echo "Then configure the hosted server using an environment-variable reference:"
echo ""
echo "  claude mcp add --scope user --transport http sbl https://mcp.sbl.so/mcp \\"
echo "    --header 'Authorization: Bearer \${SBL_API_KEY}'"
echo ""
echo "Keep the literal \${SBL_API_KEY} reference in client configuration; do not"
echo "replace it with the secret or paste the secret into chat. Restart Claude Code,"
echo "verify that exactly 30 sbl_* tools are visible, then invoke /sbl."
